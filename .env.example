# SofaScore Scraper settings (legacy names; still read in 3.0)
# The settings file of 3.0 is sofascore.toml: `ssc config init` writes one (`--from-legacy` turns this .env into
# it), `ssc config show` prints the effective values and where each one comes from, `ssc config validate` checks it.
API_BASE_URL=https://www.sofascore.com/api/v1
REQUEST_TIMEOUT=20
MAX_RETRIES=3

# Data folder (downloaded seasons, matches, details)
DATA_DIR=data
# How hard the data folder's own writes (season lists, schedules; v3/ in the data folder) are pushed
# to the disk: normal (default) = like any program, fast; full = every file and folder is synced
# before the write counts as done, so a power cut cannot lose it, at the cost of slower downloads.
STORE_DURABILITY=normal

# Anti-bot and challenge settings (Cloudflare Turnstile)
# Optional: a sofa_captcha JWT token entered by hand (empty = BrowserBridge solves the challenge itself)
SOFA_CAPTCHA_TOKEN=
# Browser profile folder (empty = default: ~/.cache/sofascore_scraper/chrome_profile)
SOFASCORE_BROWSER_PROFILE=

# Performance
MAX_CONCURRENT=10
WAIT_TIME_MIN=0.2
WAIT_TIME_MAX=0.5
# Shared request budget: how many requests per second ALL processes on this computer (web, CLI,
# --watch, --refresh-only) send to SofaScore in total, at most. Empty = 5 (the default). At that
# rate the details of a 380-match football season (~2700 requests) take about 9 minutes.
# A higher number (e.g. 20) makes downloads faster; 0 or off removes the limit altogether (every
# process on its own, as fast as it can). Both raise the risk of SofaScore blocking you: choose
# knowingly. Lower it to be gentler (at 1 and below the requests are evenly spaced).
REQUEST_RATE_LIMIT=

# Proxy
USE_PROXY=false
PROXY_URL=

# Match filtering
# Matches of every status are stored (fixtures, live, postponed); details are downloaded once a match
# has finished. true = the match lists and the dashboard show finished matches only
# (and matches whose details were downloaded). false = they show fixtures too.
FETCH_ONLY_FINISHED=true
# Refresh window (hours): a finished match record counts as provisional for this long after
# kick-off and later downloads re-read its /event; changes go to data/score_changes.jsonl. 0 = off.
REFRESH_WINDOW_HOURS=72
# Advanced: at least this many hours between two refreshes (caps the requests per match when
# downloads run hourly).
REFRESH_MIN_INTERVAL_HOURS=6

# Bridge health signal (GET /health → bridge, a banner in the web app, one line in the CLI):
# after this many rejected requests in a row (unsolved challenge / 403) the state is "degraded"...
BRIDGE_DEGRADED_AFTER=3
# ...and "blocked" after this many, once the streak has lasted at least BRIDGE_BLOCKED_MIN_SECONDS.
BRIDGE_BLOCKED_AFTER=10
BRIDGE_BLOCKED_MIN_SECONDS=200

# Circuit breaker
RATE_LIMIT_THRESHOLD_CONSECUTIVE=20
RATE_LIMIT_THRESHOLD_RATIO=0.9
SERVER_ERROR_THRESHOLD_CONSECUTIVE=50

# Display
USE_COLOR=true
DATE_FORMAT=%Y-%m-%d %H:%M:%S

# Logging
# Level: DEBUG / INFO / WARNING / ERROR / CRITICAL. Changed on the Settings page of the web app, it
# takes effect on the running server at once. DEBUG=true sets the level to DEBUG.
LOG_LEVEL=INFO
DEBUG=false
# Log file: LOG_DIR/sofascore_scraper.log (empty = logs/ in the project folder; a relative path
# is resolved against the project folder). Console output is always on; in Docker it is the
# primary output.
LOG_DIR=
# false = do not write to the file (console / `docker logs` only)
LOG_TO_FILE=true
# The file is rotated at this size (MB); at most LOG_BACKUP_COUNT older files (.1, .2, ...) are
# kept. With the defaults the logs take up to ~30 MB.
LOG_MAX_MB=5
LOG_BACKUP_COUNT=5

# Web app access (see "Security model" in the README).
# Optional access token: when set, every /api request needs it (programs send
# `Authorization: Bearer <token>`; the web app asks for it once). Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = no token, which is fine while the app only listens on this computer.
SOFASCORE_API_TOKEN=
# Host names the web app answers to, comma-separated. Empty = localhost,127.0.0.1,[::1].
# `main.py --web --host 0.0.0.0` does not start without it: list the names or IP addresses you
# open the app with, e.g. localhost,127.0.0.1,my-server.lan
SOFASCORE_ALLOWED_HOSTS=

# Language: en or tr. Empty = not pinned: the terminal, the installers and the launcher follow the
# system language (Turkish on a Turkish system, English otherwise) and the web app follows each
# browser's language. Choosing a language on the Settings page writes it here.
APP_LANGUAGE=
