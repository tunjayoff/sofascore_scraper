# SofaScore Scraper: environment settings (3.1)
#
# Every setting has an environment name SOFASCORE_<SECTION>__<KEY> (the key of sofascore.toml in capitals):
# [client] rate is SOFASCORE_CLIENT__RATE, [storage] data_dir is SOFASCORE_STORAGE__DATA_DIR. The app loads this
# file into its environment at start; a line here counts as the environment and wins over sofascore.toml and
# over the Settings page (which then shows the value as fixed). An empty line (NAME=) is the same as no line.
# Most settings are better kept in sofascore.toml (`ssc config init > sofascore.toml` prints a commented one) or
# changed on the Settings page; this file is for secrets and for what a deployment pins.
#
# The 2.x names (DATA_DIR, REQUEST_RATE_LIMIT, MAX_CONCURRENT, APP_LANGUAGE, PROXY_URL, SOFASCORE_API_TOKEN, ...)
# are not read since 3.1. `ssc doctor` and `ssc config show` name the new name of each one still set;
# `ssc config init --from-legacy > sofascore.toml` turns an old .env and config/leagues.txt into a config file.
#
#   ssc config show        the effective values and where each one comes from
#   ssc config validate    checks sofascore.toml and these variables

# --- Data folder ----------------------------------------------------------------------------------
# Downloaded seasons, matches and details (default: data in the project folder).
# SOFASCORE_STORAGE__DATA_DIR=data
# How hard the data folder's writes are pushed to the disk: normal (default) = like any program, fast;
# full = every file and folder is synced before the write counts as done, so a power cut cannot lose it,
# at the cost of slower downloads.
# SOFASCORE_STORAGE__DURABILITY=normal

# --- SofaScore requests ---------------------------------------------------------------------------
# SOFASCORE_CLIENT__BASE_URL=https://www.sofascore.com/api/v1
# SOFASCORE_CLIENT__TIMEOUT_SECONDS=10
# SOFASCORE_CLIENT__RETRIES=3
# SOFASCORE_CLIENT__MAX_CONCURRENT=10
# SOFASCORE_CLIENT__WAIT_TIME_MIN=0.2
# SOFASCORE_CLIENT__WAIT_TIME_MAX=0.5
# Shared request budget: how many requests per second ALL processes on this computer (web, CLI, ssc watch)
# send to SofaScore in total, at most (default 5). At that rate the details of a 380-match football season
# (~2700 requests) take about 9 minutes. A higher number (e.g. 20) makes downloads faster; 0 or off removes
# the limit altogether. Both raise the risk of SofaScore blocking you: choose knowingly. Lower it to be
# gentler (at 1 and below the requests are evenly spaced).
# SOFASCORE_CLIENT__RATE=5

# --- Anti-bot and challenge (Cloudflare Turnstile) ------------------------------------------------
# Optional: a sofa_captcha JWT token entered by hand (empty = the browser bridge solves the challenge itself).
SOFASCORE_CLIENT__CAPTCHA_TOKEN=
# Browser profile folder (empty = default: ~/.cache/sofascore_scraper/chrome_profile).
# SOFASCORE_CLIENT__BROWSER_PROFILE=

# --- Proxy ------------------------------------------------------------------------------------------
# A proxy given here is used (SOFASCORE_CLIENT__USE_PROXY=false turns it off without removing it). It can
# carry a password: keep this file private (the installers make it readable by its owner only).
# SOFASCORE_CLIENT__PROXY=http://user:pass@host:port

# --- Match filtering --------------------------------------------------------------------------------
# Matches of every status are stored (fixtures, live, postponed). true (default) = a league download fetches
# the details of finished matches only, and the dashboard counts finished matches (and matches whose details
# were downloaded); false = fixtures too.
# SOFASCORE_FETCH__ONLY_FINISHED=true
# Refresh window (hours): a finished match record counts as provisional for this long after kick-off and
# later downloads re-read its /event; changes go to the change log. 0 = off.
# SOFASCORE_REFRESH__WINDOW_HOURS=72
# Advanced: at least this many hours between two refreshes (caps the requests per match when downloads
# run hourly).
# SOFASCORE_REFRESH__MIN_INTERVAL_HOURS=6

# --- Bridge health (GET /health -> bridge, a banner in the web app, one line in the CLI) -------------
# After this many rejected requests in a row (unsolved challenge / 403) the state is "degraded"...
# SOFASCORE_BRIDGE__DEGRADED_AFTER=3
# ...and "blocked" after this many, once the streak has lasted at least BLOCKED_MIN_SECONDS.
# SOFASCORE_BRIDGE__BLOCKED_AFTER=10
# SOFASCORE_BRIDGE__BLOCKED_MIN_SECONDS=200

# --- Circuit breaker --------------------------------------------------------------------------------
# SOFASCORE_BREAKER__RATE_LIMIT_CONSECUTIVE=20
# SOFASCORE_BREAKER__RATE_LIMIT_RATIO=0.9
# SOFASCORE_BREAKER__SERVER_ERROR_CONSECUTIVE=50

# --- Display ----------------------------------------------------------------------------------------
# SOFASCORE_DISPLAY__USE_COLOR=true
# SOFASCORE_DISPLAY__DATE_FORMAT=%Y-%m-%d %H:%M:%S
# Language: en or tr. Not set = the terminal, the installers and the launcher follow the system language
# (Turkish on a Turkish system, English otherwise) and the web app follows each browser's language.
# "Server language" on the Settings page sets the same (saved in config/overrides.json).
# SOFASCORE_DISPLAY__LANGUAGE=en

# --- Logging ----------------------------------------------------------------------------------------
# Level: DEBUG / INFO / WARNING / ERROR / CRITICAL. Changed on the Settings page of the web app (saved in
# config/overrides.json), it takes effect on the running server at once. SOFASCORE_LOG__DEBUG=true sets the
# level to DEBUG.
# SOFASCORE_LOG__LEVEL=INFO
# SOFASCORE_LOG__DEBUG=false
# Log file: <dir>/sofascore_scraper.log (empty = logs/ in the project folder; a relative path is resolved
# against the project folder). Console output is always on; in Docker it is the primary output.
# SOFASCORE_LOG__DIR=
# false = do not write to the file (console / `docker logs` only)
# SOFASCORE_LOG__TO_FILE=true
# The file is rotated at this size (MB); at most BACKUP_COUNT older files (.1, .2, ...) are kept. With the
# defaults the logs take up to ~30 MB.
# SOFASCORE_LOG__MAX_MB=5
# SOFASCORE_LOG__BACKUP_COUNT=5

# --- Web app access (see "Security model" in the README) -------------------------------------------
# Optional access token: when set, every /api request needs it (programs send `Authorization: Bearer <token>`;
# the web app asks for it once). Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Empty = no token, which is fine while the app only listens on this computer.
SOFASCORE_SERVER__TOKEN=
# Host names the web app answers to, comma-separated (default: localhost,127.0.0.1,[::1]).
# `ssc serve --host 0.0.0.0` does not start without it: list the names or IP addresses you open the app
# with, e.g. localhost,127.0.0.1,my-server.lan
# SOFASCORE_SERVER__ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
