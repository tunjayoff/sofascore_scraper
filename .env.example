# SofaScore Scraper yapılandırma değişkenleri
API_BASE_URL=https://www.sofascore.com/api/v1
REQUEST_TIMEOUT=20
MAX_RETRIES=3

# Veri klasörü (indirilen sezonlar, maçlar, detaylar)
DATA_DIR=data

# Anti-bot ve Challenge Ayarları (Cloudflare Turnstile)
# İsteğe bağlı: Manuel sofa_captcha JWT token (boş bırakılırsa BrowserBridge otomatik çözer)
SOFA_CAPTCHA_TOKEN=
# Tarayıcı profil dizini (boş = varsayılan: ~/.cache/sofascore_scraper/chrome_profile)
SOFASCORE_BROWSER_PROFILE=

# Performans ayarları
MAX_CONCURRENT=10
WAIT_TIME_MIN=0.2
WAIT_TIME_MAX=0.5
# Ortak istek bütçesi: bu bilgisayarda çalışan TÜM süreçlerin (web, CLI, --watch, --refresh-only)
# SofaScore'a toplamda saniyede en fazla kaç istek atacağı. Boş = 5 (varsayılan). Bu hızla 380
# maçlık bir futbol sezonunun detayları (~2700 istek) yaklaşık 9 dakikada iner.
# Daha yüksek bir sayı (ör. 20) indirmeyi hızlandırır; 0 ya da off sınırı tümüyle kaldırır (her süreç
# kendi başına, olabildiğince hızlı). İkisi de SofaScore'un sizi engelleme riskini artırır: bilerek
# seçin. Daha nazik olmak için düşürün (1 ve altında istekler eşit aralıklı olur).
REQUEST_RATE_LIMIT=

# Proxy
USE_PROXY=false
PROXY_URL=

# Maç filtreleme ayarları
# true = yalnızca bitmiş maçlar (MLS/PL vb. schedule). false = fikstürleri de kaydet.
FETCH_ONLY_FINISHED=true
SAVE_EMPTY_ROUNDS=false
# Yenileme penceresi (saat): bitmiş maç kaydı başlangıçtan bu kadar süre geçici sayılır ve sonraki
# çekimlerde /event yeniden okunur; değişiklikler data/score_changes.jsonl'a yazılır. 0 = kapalı.
REFRESH_WINDOW_HOURS=72
# İleri düzey: iki yenileme arası en az bu kadar saat (saatlik çekimde maç başına istek sayısını sınırlar).
REFRESH_MIN_INTERVAL_HOURS=6

# Köprü sağlık sinyali (GET /health → bridge, web arayüzünde afiş, CLI'da tek satır):
# art arda bu kadar istek reddedilince (çözülemeyen challenge / 403) durum "degraded" olur...
BRIDGE_DEGRADED_AFTER=3
# ...bu kadar istek reddedilince ve seri en az BRIDGE_BLOCKED_MIN_SECONDS sürünce "blocked".
BRIDGE_BLOCKED_AFTER=10
BRIDGE_BLOCKED_MIN_SECONDS=200

# Circuit breaker ayarları
RATE_LIMIT_THRESHOLD_CONSECUTIVE=20
RATE_LIMIT_THRESHOLD_RATIO=0.9
SERVER_ERROR_THRESHOLD_CONSECUTIVE=50

# Görsel ayarlar
USE_COLOR=true
DATE_FORMAT=%Y-%m-%d %H:%M:%S

# Loglama
# Seviye: DEBUG / INFO / WARNING / ERROR / CRITICAL. Web arayüzündeki Ayarlar'dan değiştirilince
# çalışan sunucuda hemen geçerli olur. DEBUG=true seviyeyi DEBUG yapar.
LOG_LEVEL=INFO
DEBUG=false
# Log dosyası: LOG_DIR/sofascore_scraper.log (boş = proje klasöründeki logs/; göreli yol proje
# klasörüne göre çözülür). Konsol çıktısı her zaman açıktır; Docker'da birincil çıktı odur.
LOG_DIR=
# false = dosyaya yazma (yalnızca konsol / `docker logs`)
LOG_TO_FILE=true
# Dosya bu boyuta (MB) gelince çevrilir; en fazla LOG_BACKUP_COUNT eski dosya (.1, .2, ...) tutulur.
# Varsayılanlarla loglar en çok ~30 MB yer kaplar.
LOG_MAX_MB=5
LOG_BACKUP_COUNT=5

# Dil
APP_LANGUAGE=tr
