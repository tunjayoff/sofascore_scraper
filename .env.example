# SofaScore Scraper yapılandırma değişkenleri
API_BASE_URL=https://www.sofascore.com/api/v1
REQUEST_TIMEOUT=20
MAX_RETRIES=3

# Veri klasörü (indirilen sezonlar, maçlar, detaylar)
DATA_DIR=data

# Anti-bot ve Challenge Ayarları (Cloudflare Turnstile)
# İsteğe bağlı: Manuel sofa_captcha JWT token (boş bırakılırsa BrowserBridge otomatik çözer)
SOFA_CAPTCHA_TOKEN=
# Tarayıcı profil dizini (varsayılan: ~/.cache/sofascore_scraper/chrome_profile)
SOFASCORE_CHROME_PROFILE=

# Performans ayarları
MAX_CONCURRENT=10
WAIT_TIME_MIN=0.2
WAIT_TIME_MAX=0.5

# Proxy
USE_PROXY=false
PROXY_URL=

# Maç filtreleme ayarları
# true = yalnızca bitmiş maçlar (MLS/PL vb. schedule). false = fikstürleri de kaydet.
FETCH_ONLY_FINISHED=true
SAVE_EMPTY_ROUNDS=false
# Yenileme penceresi (saat): bitmiş maç kaydı başlangıçtan bu kadar süre geçici sayılır ve sonraki
# çekimlerde /event yeniden okunur; değişiklikler data/score_changes.jsonl'a yazılır. 0 = kapalı.
REFRESH_WINDOW_HOURS=72

# Circuit breaker ayarları
RATE_LIMIT_THRESHOLD_CONSECUTIVE=20
RATE_LIMIT_THRESHOLD_RATIO=0.9
SERVER_ERROR_THRESHOLD_CONSECUTIVE=50

# Görsel ayarlar
USE_COLOR=true
DATE_FORMAT=%Y-%m-%d %H:%M:%S

# Loglama
LOG_LEVEL=INFO
DEBUG=false

# Dil
APP_LANGUAGE=tr
